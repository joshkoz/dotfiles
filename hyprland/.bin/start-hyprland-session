#!/bin/bash
# Hyprland Systemd Wrapper

set -euo pipefail

# Only start from a local seat session: a virtual terminal (login prompt, ly) or a session
# logind placed on a VT (XDG_VTNR, set by pam_systemd, e.g. greetd). Rejects SSH and serial.
if [[ ! "$(tty)" =~ /dev/tty[0-9] && -z "${XDG_VTNR:-}" ]]; then
    echo "Hyprland session must be started from a virtual terminal (TTY)"
    exit 1
fi

# Check if a graphical session is already running
if systemctl --user is-active --quiet graphical-session.target; then
    echo "A graphical session is already running"
    exit 1
fi

# No "Starting..." message: under greetd stdout is the VT, so it flashed on screen after login.

# Clean start
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY
# XDG_SESSION_ID: services in the user manager (noctalia) aren't inside the logind session,
# so they need it to find the session for `loginctl lock-session`, lock hints, etc.
systemctl --user import-environment PATH XDG_SESSION_ID

# Start the session and wait for Hyprland to exit
systemctl --user start hyprland-session.target
exec systemctl --user start --wait hyprland.service
