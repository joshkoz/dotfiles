[global]
    frame_color = "#f5a97f"
    background = "#24273a"
    foreground = "#cad3f5"

[urgency_low]
    background = "#24273a"
    foreground = "#cad3f5"
    frame_color = "#363a4f"

[urgency_normal]
    background = "#24273a"
    foreground = "#cad3f5"
    frame_color = "#f5a97f"

[urgency_critical]
    background = "#ed8796"
    foreground = "#24273a"
    frame_color = "#ed8796"
