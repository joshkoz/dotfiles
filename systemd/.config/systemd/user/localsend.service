[Unit]
Description=LocalSend - File Sharing Client
After=noctalia.service wayland-session.target
PartOf=wayland-session.target
BindsTo=wayland-session.target

[Service]
Type=simple
# We omit the pkill logic because systemd manages the lifecycle properly
# -x matches the process name exactly. The old `-f localsend` matched any command line
# containing "localsend", including `systemctl --user restart localsend` itself.
ExecStartPre=-/usr/bin/pkill -u %u -x localsend
ExecStart=/usr/bin/flatpak run org.localsend.localsend_app --hidden
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=wayland-session.target
