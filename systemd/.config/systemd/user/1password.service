[Unit]
Description=1Password Linux desktop client
Documentation=https://support.1password.com/
# Start after Noctalia is ready, so the tray icon registers.
After=noctalia.service wayland-session.target
BindsTo=wayland-session.target

[Service]
Type=simple
# Fix for Wayland: Force native ozone and clear old DISPLAY hangs
Environment=ELECTRON_OZONE_PLATFORM_HINT=auto

# noctalia.service is Type=notify, so After= already waits for the tray to be up
ExecStart=/usr/bin/1password --silent

Restart=on-abnormal
RestartSec=5s
OOMPolicy=continue

[Install]
WantedBy=wayland-session.target
